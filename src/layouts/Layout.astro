---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AC-COMPRO | Solusi Tata Udara & Pendingin Ruangan Profesional",
  description = "Layanan instalasi, pemeliharaan rutin, cuci AC, dan perbaikan sistem pendingin (HVAC) untuk hunian, kantor, dan industri dengan standar profesional dan bergaransi."
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Google Fonts Preconnect & Stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col relative selection:bg-cyan-500/20 selection:text-cyan-300">
    <!-- Ambient Background Lighting -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[700px] h-[500px] bg-cyan-500/10 blur-[130px] rounded-full"></div>
      <div class="absolute top-[40%] -left-32 w-[500px] h-[500px] bg-blue-600/10 blur-[140px] rounded-full"></div>
      <div class="absolute top-[75%] -right-32 w-[600px] h-[600px] bg-sky-500/10 blur-[150px] rounded-full"></div>
    </div>

    <!-- Navigation Bar -->
    <Navbar />

    <!-- Main Content -->
    <main class="flex-grow z-10">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
