---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AC Family Teknik | Company Profile",
  description = "Solusi tata udara & pendingin ruangan profesional."
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,700;1,900&display=swap" rel="stylesheet" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
  </head>
  <body class="bg-[#1e2dfc] text-white min-h-screen m-0 p-0 antialiased selection:bg-white selection:text-[#1e2dfc] overflow-x-hidden">
    <slot />
  </body>
</html>
