---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="AC FAMILY | Company Profile">
  <!-- Main Banner Container with #1e2dfc Blue Theme & Decorative Background -->
  <div class="w-full max-w-[1440px] mx-auto min-h-[550px] md:min-h-[640px] bg-gradient-to-br from-[#1e2dfc] via-[#1826ea] to-[#0e179e] rounded-t-[36px] sm:rounded-t-[44px] md:rounded-t-[52px] relative overflow-hidden shadow-2xl flex flex-col justify-between">
    
    <!-- Background Ambient Decorative Rings (Matching the KFC screenshot watermarks) -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden select-none">
      <!-- Top Center Large Faint Ring -->
      <div class="absolute -top-24 left-[38%] w-72 h-72 rounded-full border-[28px] border-white/[0.04]"></div>
      <!-- Far Right Large Ring -->
      <div class="absolute top-12 -right-20 w-[420px] h-[420px] rounded-full border-[45px] border-white/[0.04]"></div>
      <!-- Bottom Left Ring -->
      <div class="absolute -bottom-28 -left-20 w-80 h-80 rounded-full border-[35px] border-white/[0.04]"></div>
      <!-- Subtle Center Radial Glow -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-white/[0.03] rounded-full blur-3xl"></div>
    </div>

    <!-- Section 1: Top Header Bar -->
    <Header />

    <!-- Placeholder Space for Section 2 (Hero Content: Title, Offer Badge, Product image, Order button) -->
    <div class="flex-grow flex items-center justify-center p-8 relative z-10">
      <!-- Kita kosongkan dulu agar fokus 100% pada bagian Header atas sesuai permintaan -->
    </div>

    <!-- Bottom Wave / Menu Indicator Placeholder (Sesuai referensi bawah jika diperlukan nantinya) -->
    <div class="relative z-10 h-8"></div>

  </div>
</Layout>
