---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="AC FAMILY | Company Profile">
  <!-- Full Width Background Canvas in #1e2dfc Blue -->
  <div class="w-full min-h-screen bg-[#1e2dfc] relative overflow-hidden flex flex-col justify-between">
    
    <!-- Background Ambient Decorative Watermark Rings across the full screen -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden select-none">
      <!-- Top Center Faint Ring -->
      <div class="absolute -top-32 left-[40%] w-[380px] h-[380px] rounded-full border-[36px] border-white/[0.05]"></div>
      <!-- Right Side Massive Ring -->
      <div class="absolute top-10 -right-28 w-[580px] h-[580px] rounded-full border-[60px] border-white/[0.05]"></div>
      <!-- Bottom Left Ring -->
      <div class="absolute -bottom-36 -left-24 w-[460px] h-[460px] rounded-full border-[48px] border-white/[0.05]"></div>
      <!-- Subtle Center Radial Lighting -->
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] bg-white/[0.04] rounded-full blur-3xl"></div>
    </div>

    <!-- Top Header Bar -->
    <div class="w-full max-w-[1440px] mx-auto">
      <Header />
    </div>

    <!-- Main Hero Body Area (Vertically Centered) -->
    <main class="flex-grow w-full max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-16 relative z-10 flex items-center py-10 lg:py-16">
      <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Left Column: Big Headline -->
        <div class="lg:col-span-7 space-y-6 text-left">
          <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black uppercase tracking-tight text-white leading-[1.08] drop-shadow-sm font-sans max-w-2xl">
            Cepat Datang,<br />
            Dingin Kembali
          </h1>
        </div>

        <!-- Right Column: Space for Hero Product/Showcase (Ready for next step) -->
        <div class="lg:col-span-5 relative flex items-center justify-center">
          <!-- Area visual di kanan -->
        </div>

      </div>
    </main>

    <!-- Bottom Margin / Footer Spacer -->
    <div class="relative z-10 h-8"></div>

  </div>
</Layout>
