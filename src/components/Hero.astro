---
const stats = [
  { value: "10.000+", label: "Unit AC Terlayani" },
  { value: "99.8%", label: "Tingkat Kepuasan" },
  { value: "15+ Thn", label: "Pengalaman Industri" },
  { value: "24/7", label: "Layanan Tanggap" },
];
---

<section id="beranda" class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Content Column -->
      <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
        
        <!-- Live Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full glass-panel border-cyan-500/30 text-cyan-300 text-xs sm:text-sm font-semibold tracking-wide">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span>Solusi HVAC & Air Conditioning Profesional</span>
        </div>

        <!-- Main Title -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15] text-white">
          Hadirkan Kesejukan Maksimal & Udara Bersih di
          <span class="bg-gradient-to-r from-cyan-400 via-sky-300 to-blue-500 bg-clip-text text-transparent"> Setiap Ruangan</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Penyedia jasa instalasi, cuci AC berkala, perbaikan mesin pendingin, hingga instalasi VRV/VRF dan ducting untuk residensial, perkantoran, dan gedung komersial dengan teknisi bersertifikasi.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a
            href="https://wa.me/6281234567890?text=Halo%20AC-COMPRO,%20saya%20butuh%20layanan%20AC"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl text-base font-bold text-slate-950 bg-gradient-to-r from-cyan-400 to-sky-400 hover:from-cyan-300 hover:to-sky-300 shadow-xl shadow-cyan-500/25 hover:shadow-cyan-500/40 transition-all duration-300 transform hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Jadwalkan Teknisi
          </a>
          
          <a
            href="#layanan"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl text-base font-semibold text-slate-200 glass-panel hover:bg-slate-800/80 border-slate-700/80 hover:border-slate-600 transition-all duration-200"
          >
            Lihat Layanan Kami
            <svg class="w-4 h-4 text-slate-400 group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

        <!-- Guarantee Checklist -->
        <div class="pt-4 flex flex-wrap items-center justify-center lg:justify-start gap-y-2 gap-x-6 text-xs sm:text-sm text-slate-300">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Garansi Pengerjaan 30 Hari</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Teknisi Berpengalaman & Resmi</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Suku Cadang Asli & Bersertifikat</span>
          </div>
        </div>

      </div>

      <!-- Right Interactive Showcase Column -->
      <div class="lg:col-span-5 relative">
        <!-- Floating Visual Card / Glassmorphism Hub -->
        <div class="relative mx-auto max-w-md w-full glass-panel rounded-3xl p-6 sm:p-8 border border-slate-700/60 shadow-2xl shadow-cyan-950/50">
          
          <!-- Card Header -->
          <div class="flex items-center justify-between border-b border-slate-800 pb-5 mb-6">
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></div>
              <div>
                <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold block">Smart Climate Monitor</span>
                <span class="text-sm font-bold text-white">Status Unit: Optimal</span>
              </div>
            </div>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-cyan-500/10 text-cyan-300 border border-cyan-500/20">
              Eco-Inverter
            </span>
          </div>

          <!-- Main Temperature Display -->
          <div class="text-center py-6 relative">
            <div class="inline-flex flex-col items-center justify-center w-40 h-40 rounded-full border-4 border-cyan-500/20 bg-gradient-to-b from-slate-900 to-slate-950 relative shadow-inner">
              <span class="text-5xl font-black text-white tracking-tight">18°<span class="text-2xl text-cyan-400">C</span></span>
              <span class="text-xs text-slate-400 mt-1 font-medium">Suhu Sejuk Nyaman</span>
              
              <!-- Indicator Sparkle -->
              <div class="absolute -top-1 right-3 w-3 h-3 rounded-full bg-cyan-400 glow-cyan"></div>
            </div>
          </div>

          <!-- Quick Metrics Grid -->
          <div class="grid grid-cols-2 gap-3 mt-4">
            <div class="p-3.5 rounded-2xl bg-slate-900/80 border border-slate-800/80">
              <span class="text-xs text-slate-400 block">Kualitas Udara (AQI)</span>
              <div class="flex items-center gap-1.5 mt-1">
                <span class="text-lg font-bold text-emerald-400">98%</span>
                <span class="text-[10px] text-emerald-300/80 uppercase font-semibold">Sangat Bersih</span>
              </div>
            </div>

            <div class="p-3.5 rounded-2xl bg-slate-900/80 border border-slate-800/80">
              <span class="text-xs text-slate-400 block">Efisiensi Energi</span>
              <div class="flex items-center gap-1.5 mt-1">
                <span class="text-lg font-bold text-cyan-400">A+++</span>
                <span class="text-[10px] text-cyan-300/80 uppercase font-semibold">Hemat Listrik</span>
              </div>
            </div>
          </div>

          <!-- Service Guarantee Badge -->
          <div class="mt-5 p-3 rounded-xl bg-cyan-950/40 border border-cyan-800/40 flex items-center justify-between text-xs text-cyan-200">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>Jaminan dingin & bebas bocor</span>
            </div>
            <span class="font-bold text-cyan-400">Terverifikasi</span>
          </div>

        </div>
      </div>

    </div>

    <!-- Metrics Strip -->
    <div class="mt-16 md:mt-24 grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {stats.map((stat) => (
        <div class="glass-panel p-6 rounded-2xl border-slate-800/80 text-center hover:border-cyan-500/30 transition-all duration-300">
          <p class="text-3xl sm:text-4xl font-extrabold bg-gradient-to-r from-cyan-400 to-sky-300 bg-clip-text text-transparent">
            {stat.value}
          </p>
          <p class="text-xs sm:text-sm text-slate-400 font-medium mt-1">
            {stat.label}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
