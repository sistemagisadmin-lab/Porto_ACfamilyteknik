      desc: "Layanan prioritas untuk rumah, ruko, kantor & klinik.",
      badge: "24/7 SIAGA",
      badgeBg: "bg-blue-600",
      iconSvg: `<svg class="w-12 h-12 text-blue-600 drop-shadow-md" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
