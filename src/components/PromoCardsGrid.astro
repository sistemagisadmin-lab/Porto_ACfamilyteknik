  // Active indices for each card
  let activeSlide = [0, 0, 0];
  let autoSlideTimer: number | null = null;

  function updateCard1(slideIdx: number) {
    activeSlide[0] = slideIdx;
    const data = card1Slides[slideIdx];
    const card = document.querySelector('[data-card-index="0"]');
    if (!card) return;

    const title = card.querySelector('.card-title');
    const desc = card.querySelector('.card-desc');
    const price = card.querySelector('.card-price');
    const badge = card.querySelector('.card-badge');
    const img = card.querySelector('.card-img') as HTMLImageElement;
    const imgWrap = card.querySelector('.card-img-wrap');
    const dots = card.querySelectorAll('.dot-btn');

    // Smooth transition
    if (title) title.innerHTML = data.title;
    if (desc) desc.textContent = data.desc;
    if (price) price.innerHTML = data.price;
    if (badge) {
      badge.textContent = data.badge;
      badge.className = `card-badge absolute -top-2 -right-1 z-20 px-2.5 py-0.5 rounded-full ${data.badgeBg} text-white font-black text-[9px] uppercase tracking-wider shadow-sm`;
    }
    if (img) img.src = data.image;
    if (imgWrap) imgWrap.className = `card-img-wrap w-20 h-20 sm:w-24 sm:h-24 md:w-28 md:h-28 rounded-full ${data.imgBg} flex items-center justify-center p-2 group-hover:scale-105 transition-transform duration-300`;

    // Update dots
    dots.forEach((dot, idx) => {
      if (idx === slideIdx) {
        dot.className = "dot-btn transition-all duration-300 w-5 h-1.5 rounded-full bg-amber-400";
      } else {
        dot.className = "dot-btn transition-all duration-300 w-1.5 h-1.5 rounded-full bg-slate-300 hover:bg-slate-400";
      }
    });
  }

  function updateCard2(slideIdx: number) {
    activeSlide[1] = slideIdx;
    const data = card2Slides[slideIdx];
    const card = document.querySelector('[data-card-index="1"]');
    if (!card) return;

    const title = card.querySelector('.card-title');
    const desc = card.querySelector('.card-desc');
    const price = card.querySelector('.card-price');
    const badge = card.querySelector('.card-badge');
    const img = card.querySelector('.card-img') as HTMLImageElement;
    const dots = card.querySelectorAll('.dot-btn');

    if (title) title.innerHTML = data.title;
    if (desc) desc.textContent = data.desc;
    if (price) price.textContent = data.price;
    if (badge) {
      badge.textContent = data.badge;
      badge.className = `card-badge absolute -top-2 -right-1 z-20 px-2 sm:px-2.5 py-0.5 rounded-full ${data.badgeBg} font-black text-[8px] sm:text-[9px] uppercase tracking-wider shadow-sm`;
    }
    if (img) img.src = data.image;

    // Update dots
    dots.forEach((dot, idx) => {
      if (idx === slideIdx) {
        dot.className = "dot-btn transition-all duration-300 w-5 h-1.5 rounded-full bg-white";
      } else {
        dot.className = "dot-btn transition-all duration-300 w-1.5 h-1.5 rounded-full bg-white/40 hover:bg-white/70";
      }
    });
  }

  function updateCard3(slideIdx: number) {
    activeSlide[2] = slideIdx;
    const data = card3Slides[slideIdx];
    const card = document.querySelector('[data-card-index="2"]');
    if (!card) return;

    const title = card.querySelector('.card-title');
    const desc = card.querySelector('.card-desc');
    const badge = card.querySelector('.card-badge');
    const iconWrap = card.querySelector('.card-img-wrap');
    const iconBox = card.querySelector('.card-icon-box');
    const dots = card.querySelectorAll('.dot-btn');

    if (title) title.innerHTML = data.title;
    if (desc) desc.textContent = data.desc;
    if (badge) {
      badge.textContent = data.badge;
      badge.className = `card-badge absolute -top-2 -right-1 z-20 px-2 sm:px-2.5 py-0.5 rounded-full ${data.badgeBg} text-white font-black text-[8px] sm:text-[9px] uppercase tracking-wider shadow-sm`;
    }
    if (iconBox) iconBox.innerHTML = data.iconSvg;
    if (iconWrap) iconWrap.className = `card-img-wrap w-20 h-20 sm:w-24 sm:h-24 md:w-28 md:h-28 rounded-full ${data.iconBg} flex items-center justify-center p-2 group-hover:scale-105 transition-transform duration-300`;

    // Update dots
    dots.forEach((dot, idx) => {
      if (idx === slideIdx) {
        dot.className = "dot-btn transition-all duration-300 w-5 h-1.5 rounded-full bg-amber-400";
      } else {
        dot.className = "dot-btn transition-all duration-300 w-1.5 h-1.5 rounded-full bg-slate-300 hover:bg-slate-400";
      }
    });
  }

  // Setup click listeners on all dots
  document.querySelectorAll('.card-dots').forEach(container => {
    const cardIdx = container.getAttribute('data-card');
    const dots = container.querySelectorAll('.dot-btn');

    dots.forEach((dot, dotIdx) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        if (cardIdx === '0') updateCard1(dotIdx);
        else if (cardIdx === '1') updateCard2(dotIdx);
        else if (cardIdx === '2') updateCard3(dotIdx);
        resetAutoTimer();
      });
    });
  });

  // Setup click listeners on cards to cycle slide
  document.querySelectorAll('.promo-card').forEach(card => {
    const cardIdx = card.getAttribute('data-card-index');
    card.addEventListener('click', (e) => {
      // If clicked on a link or button, don't interfere
      if ((e.target as HTMLElement).closest('a') || (e.target as HTMLElement).closest('button')) return;

      if (cardIdx === '0') {
        const next = (activeSlide[0] + 1) % card1Slides.length;
        updateCard1(next);
      } else if (cardIdx === '1') {
        const next = (activeSlide[1] + 1) % card2Slides.length;
        updateCard2(next);
      } else if (cardIdx === '2') {
        const next = (activeSlide[2] + 1) % card3Slides.length;
        updateCard3(next);
      }
      resetAutoTimer();
    });
  });

  // Auto-play sliding cycle every 3.5 seconds
  function startAutoCycle() {
    stopAutoCycle();
    autoSlideTimer = window.setInterval(() => {
      updateCard1((activeSlide[0] + 1) % card1Slides.length);
      updateCard2((activeSlide[1] + 1) % card2Slides.length);
      updateCard3((activeSlide[2] + 1) % card3Slides.length);
    }, 3500);
  }

  function stopAutoCycle() {
    if (autoSlideTimer) {
      clearInterval(autoSlideTimer);
      autoSlideTimer = null;
    }
  }

  function resetAutoTimer() {
    stopAutoCycle();
    startAutoCycle();
  }

  // Start auto-slide on page load
  startAutoCycle();
</script>
