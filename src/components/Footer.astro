<footer id="kontak" class="w-full bg-[#0a1128] text-white border-t border-blue-900/40 relative z-20">
  
  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 sm:pt-16 pb-8 sm:pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 md:gap-10 lg:gap-12 pb-8 sm:pb-12 border-b border-slate-800">
      
      <!-- Brand Profile & Tagline (5 Cols) -->
      <div class="lg:col-span-5 space-y-3 sm:space-y-4">
        <div class="flex items-center gap-3">
          <img
            src="/assets/logo.png"
            alt="PT Family Teknik Paimin Groups Logo"
            class="h-10 sm:h-12 w-auto object-contain brightness-0 invert"
          />
        </div>
        
        <h3 class="text-lg sm:text-xl font-black uppercase tracking-tight text-white">
          PT Family Teknik Paimin Groups
        </h3>

        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-md">
          Solusi terpercaya perawatan, cuci AC, perbaikan mesin pendingin, isi freon, dan bongkar pasang unit AC untuk seluruh wilayah <strong class="text-white">Jabodetabek</strong>.
