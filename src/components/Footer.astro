---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-800/80 bg-slate-950/90 pt-16 pb-12 relative z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800/80">
      
      <!-- Brand & Info -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-600 to-blue-600 flex items-center justify-center text-white shadow-md">
            <svg class="w-5 h-5 text-cyan-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <span class="text-xl font-bold tracking-tight text-white">
            AC<span class="text-cyan-400">COMPRO</span>
          </span>
        </div>
        <p class="text-sm text-slate-400 max-w-sm leading-relaxed">
          Penyedia solusi tata udara, pemeliharaan HVAC, dan perbaikan pendingin ruangan terpercaya untuk hunian, komersial, dan sektor industri di Indonesia.
        </p>
        <div class="flex items-center gap-3 text-slate-400 pt-2">
          <span class="text-xs px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-slate-300">
            ⚡ Respon Cepat 24 Jam
          </span>
          <span class="text-xs px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-cyan-300">
            🛡️ 100% Bergaransi
          </span>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Navigasi Cepat</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="#beranda" class="hover:text-cyan-400 transition-colors">Beranda</a></li>
          <li><a href="#layanan" class="hover:text-cyan-400 transition-colors">Layanan Kami</a></li>
          <li><a href="#tentang" class="hover:text-cyan-400 transition-colors">Tentang Perusahaan</a></li>
          <li><a href="#alur" class="hover:text-cyan-400 transition-colors">Alur Pengerjaan</a></li>
          <li><a href="#testimoni" class="hover:text-cyan-400 transition-colors">Testimoni Klien</a></li>
        </ul>
      </div>

      <!-- Services Links -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Layanan Populer</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="#layanan" class="hover:text-cyan-400 transition-colors">Cuci AC Steam</a></li>
          <li><a href="#layanan" class="hover:text-cyan-400 transition-colors">Bongkar Pasang AC</a></li>
          <li><a href="#layanan" class="hover:text-cyan-400 transition-colors">Perbaikan Kompresor</a></li>
          <li><a href="#layanan" class="hover:text-cyan-400 transition-colors">HVAC VRV / VRF Gedung</a></li>
          <li><a href="#layanan" class="hover:text-cyan-400 transition-colors">Isi & Tambah Freon</a></li>
        </ul>
      </div>

      <!-- Operational Info -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Jam Operasional</h4>
        <div class="text-xs text-slate-400 space-y-1.5">
          <p><span class="font-medium text-slate-300">Senin - Sabtu:</span> 07.30 - 20.00 WIB</p>
          <p><span class="font-medium text-slate-300">Minggu & Libur:</span> 08.00 - 18.00 WIB</p>
          <p><span class="font-medium text-cyan-400">Emergency 24/7:</span> Siaga untuk B2B & Gedung</p>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>&copy; {currentYear} AC-COMPRO. Seluruh hak cipta dilindungi.</p>
      <div class="flex items-center gap-6">
        <a href="#" class="hover:text-slate-400 transition-colors">Kebijakan Privasi</a>
        <a href="#" class="hover:text-slate-400 transition-colors">Syarat & Ketentuan</a>
        <a href="#" class="hover:text-slate-400 transition-colors">Garansi Layanan</a>
      </div>
    </div>

  </div>
</footer>
