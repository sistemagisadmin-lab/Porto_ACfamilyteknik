---
// Floating WhatsApp & Quick Contact Widget for PT Family Teknik Paimin Groups
---

<!-- Floating Quick Contact Widget -->
<div class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50 flex flex-col items-end select-none">
  
  <!-- Popup Contact Panel (Hidden by default, toggle on button click) -->
  <div
    id="wa-popup-panel"
    class="hidden mb-3 w-[calc(100vw-32px)] max-w-xs sm:w-80 bg-white rounded-3xl shadow-2xl border border-slate-200 overflow-hidden transform transition-all duration-300 origin-bottom-right"
  >
    <!-- Header Popup -->
    <div class="bg-[#1e2dfc] p-4 text-white flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-full bg-white/20 flex items-center justify-center text-[#1e2dfc]">
          <!-- Snowflake Vector Icon -->
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M19.07 4.93L4.93 19.07" />
          </svg>
        </div>
        <div>
          <h4 class="text-xs font-black uppercase tracking-wider">PT Family Teknik</h4>
          <p class="text-[10px] text-white/80">Online & Siaga Jabodetabek</p>
        </div>
      </div>
      <button
        id="wa-close-btn"
        type="button"
        aria-label="Tutup Menu"
        class="w-7 h-7 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white text-xs font-bold transition-colors"
      >
        &times;
      </button>
    </div>

    <!-- Body Contact List -->
    <div class="p-3.5 space-y-2 bg-slate-50 text-slate-800">
      <p class="text-[11px] font-semibold text-slate-500 px-1">
        Pilih admin untuk respon cepat:
      </p>

      <!-- Admin 1 -->
      <a
        href="https://wa.me/6288219639143?text=Halo%20Admin%201%20PT%20Family%20Teknik,%20saya%20ingin%20konsultasi%20layanan%20AC"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between p-3 rounded-2xl bg-white border border-slate-200 hover:border-emerald-500 hover:shadow-md transition-all group"
      >
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-emerald-500 text-white flex items-center justify-center shrink-0 shadow-sm">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </div>
          <div class="text-left">
            <span class="text-xs font-black text-slate-900 block group-hover:text-emerald-600 transition-colors">Admin 1</span>
            <span class="text-[11px] font-bold text-slate-500">0882-1963-9143</span>
          </div>
        </div>
        <span class="text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-600 border border-emerald-200">
          Chat
        </span>
      </a>

      <!-- Admin 2 -->
      <a
        href="https://wa.me/6285695410841?text=Halo%20Admin%202%20PT%20Family%20Teknik,%20saya%20ingin%20konsultasi%20layanan%20AC"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between p-3 rounded-2xl bg-white border border-slate-200 hover:border-emerald-500 hover:shadow-md transition-all group"
      >
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-emerald-500 text-white flex items-center justify-center shrink-0 shadow-sm">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </div>
          <div class="text-left">
            <span class="text-xs font-black text-slate-900 block group-hover:text-emerald-600 transition-colors">Admin 2</span>
            <span class="text-[11px] font-bold text-slate-500">0856-9541-0841</span>
          </div>
        </div>
        <span class="text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-600 border border-emerald-200">
          Chat
        </span>
      </a>

      <!-- Instagram Link -->
      <a
        href="https://www.instagram.com/acservice.jabodetabek/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between p-3 rounded-2xl bg-white border border-slate-200 hover:border-pink-500 hover:shadow-md transition-all group"
      >
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-amber-500 via-pink-500 to-purple-500 text-white flex items-center justify-center shrink-0 shadow-sm">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </div>
          <div class="text-left">
            <span class="text-xs font-black text-slate-900 block group-hover:text-pink-600 transition-colors">Instagram Resmi</span>
            <span class="text-[11px] font-bold text-slate-500">@acservice.jabodetabek</span>
          </div>
        </div>
        <span class="text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full bg-pink-50 text-pink-600 border border-pink-200">
          Lihat
        </span>
      </a>
    </div>

    <!-- Quick Note -->
    <div class="p-2.5 bg-slate-100 border-t border-slate-200 text-center">
      <span class="text-[10px] font-bold text-slate-600">Rumah • Kantor • Apartemen (Jabodetabek)</span>
    </div>
  </div>

  <!-- Floating Trigger Button -->
  <button
    id="wa-toggle-btn"
    type="button"
    aria-label="Chat WhatsApp Admin"
    class="relative group flex items-center gap-2.5 px-4 py-3 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white shadow-xl shadow-emerald-600/30 hover:shadow-emerald-600/50 hover:scale-105 active:scale-95 transition-all duration-300"
  >
    <!-- WhatsApp Icon SVG -->
    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
    </svg>

    <span class="text-xs font-black uppercase tracking-wider hidden sm:inline-block">
      Chat WhatsApp
    </span>
  </button>

</div>

<script>
  const toggleBtn = document.getElementById('wa-toggle-btn');
  const popupPanel = document.getElementById('wa-popup-panel');
  const closeBtn = document.getElementById('wa-close-btn');

  if (toggleBtn && popupPanel) {
    toggleBtn.addEventListener('click', () => {
      popupPanel.classList.toggle('hidden');
    });
  }

  if (closeBtn && popupPanel) {
    closeBtn.addEventListener('click', () => {
      popupPanel.classList.add('hidden');
    });
  }
</script>
