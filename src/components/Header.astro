---
interface Props {
  brandName?: string;
}

const { brandName = "PT FAMILY TEKNIK PAIMIN GROUPS" } = Astro.props;

const navLinks = [
  { name: "PROMO & LAYANAN", href: "#promo" },
  { name: "DAFTAR HARGA", href: "#pricelist" },
  { name: "KONTAK KAMI", href: "#kontak" },
];
---

<!-- Top Header Component in #1e2dfc Blue Theme -->
<header class="w-full relative z-30 px-4 sm:px-8 lg:px-14 pt-5 sm:pt-7 pb-3 sm:pb-4">
  <div class="flex items-center justify-between">
    
    <!-- Left: Pure White Brand Logo from public/assets/logo.png -->
    <a href="/" class="flex items-center gap-2 group select-none py-1">
      <img
        src="/assets/logo.png"
        alt="PT Family Teknik Paimin Groups Logo"
        class="h-10 sm:h-12 md:h-14 lg:h-16 w-auto object-contain transition-transform duration-200 group-hover:scale-105 drop-shadow-sm"
        loading="eager"
      />
    </a>

    <!-- Right Side Group: Menu Links + Action Buttons -->
    <div class="flex items-center gap-3 sm:gap-6 md:gap-8 lg:gap-10">
      
      <!-- Navigation Links (Uppercase, clean tracking on desktop) -->
      <nav class="hidden md:flex items-center gap-5 lg:gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-[12px] lg:text-[13px] font-extrabold uppercase tracking-widest text-white/90 hover:text-white hover:opacity-100 transition-opacity duration-200"
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Build by Sistemagis Header Badge (Desktop & Tablet) -->
      <a
        href="https://www.tiktok.com/@sistemagis"
        target="_blank"
        rel="noopener noreferrer"
        title="Build by Sistemagis"
        class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/25 text-white transition-all backdrop-blur-md group hover:scale-105 active:scale-95 select-none shadow-sm"
      >
        <span class="text-[10px] font-bold text-white/90 uppercase tracking-wider group-hover:text-white whitespace-nowrap">Build by</span>
        <img
          src="/assets/sistemagis.png"
          alt="Sistemagis Logo"
          class="h-3.5 w-auto object-contain transition-transform group-hover:scale-105 brightness-110"
          loading="eager"
        />
      </a>

      <!-- Action Icons (Instagram + WhatsApp Quick Buttons) -->
      <div class="flex items-center gap-2.5 sm:gap-3">
        
        <!-- Instagram Link Button (White Circle) -->
        <a
          href="https://www.instagram.com/acservice.jabodetabek/"
          target="_blank"
          rel="noopener noreferrer"
          title="Instagram @acservice.jabodetabek"
          aria-label="Instagram Resmi"
          class="w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 rounded-full bg-white text-[#1e2dfc] flex items-center justify-center shadow-lg shadow-black/10 hover:scale-105 active:scale-95 transition-all duration-200 shrink-0"
        >
          <!-- Instagram Icon -->
          <svg class="w-5 h-5 sm:w-6 sm:h-6 text-[#1e2dfc]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>

        <!-- WhatsApp Quick Chat Button -->
        <a
          href="https://wa.me/6288219639143?text=Halo%20PT%20Family%20Teknik%20Paimin%20Groups,%20saya%20ingin%20konsultasi%20layanan%20AC"
          target="_blank"
          rel="noopener noreferrer"
          title="Chat WhatsApp Admin 1 (0882-1963-9143)"
          aria-label="WhatsApp Admin"
          class="w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 rounded-full bg-white text-emerald-600 flex items-center justify-center shadow-lg shadow-black/10 hover:scale-105 active:scale-95 transition-all duration-200 shrink-0 group"
        >
          <!-- WhatsApp Icon Bold & Big -->
          <svg class="w-6 h-6 sm:w-7 sm:h-7 text-emerald-600 group-hover:scale-110 transition-transform duration-200" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-nav-toggle"
          type="button"
          class="md:hidden w-10 h-10 rounded-full bg-white/15 text-white flex items-center justify-center hover:bg-white/25 active:scale-95 transition-all focus:outline-none"
          aria-label="Toggle Menu"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

      </div>

    </div>

  </div>

  <!-- Mobile Dropdown Navigation (Glassmorphic Container) -->
  <div id="mobile-nav-menu" class="hidden md:hidden mt-3 p-4 bg-[#1422c8]/95 backdrop-blur-md rounded-2xl border border-white/20 shadow-2xl space-y-3">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block text-sm font-extrabold uppercase tracking-wider text-white hover:text-cyan-300 py-1.5 border-b border-white/10 last:border-none"
      >
        {link.name}
      </a>
    ))}
    
    <!-- Mobile WhatsApp Buttons -->
    <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
      <a
        href="https://wa.me/6288219639143"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-black uppercase text-center bg-emerald-500 hover:bg-emerald-600 text-white px-4 py-2.5 rounded-xl shadow-md transition-colors"
      >
        WhatsApp Admin 1
      </a>
      <a
        href="https://wa.me/6285695410841"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-black uppercase text-center bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-xl shadow-md transition-colors"
      >
        WhatsApp Admin 2
      </a>
    </div>

    <!-- Mobile Built by Sistemagis link -->
    <div class="pt-2 border-t border-white/15 flex items-center justify-center">
      <a
        href="https://www.tiktok.com/@sistemagis"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 text-white text-xs font-medium hover:bg-white/20 transition-colors"
      >
        <span class="text-[11px] text-white/80">Build by</span>
        <img
          src="/assets/sistemagis.png"
          alt="Sistemagis"
          class="h-3.5 w-auto object-contain"
        />
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const navMenu = document.getElementById('mobile-nav-menu');

  if (toggleBtn && navMenu) {
    toggleBtn.addEventListener('click', () => {
      navMenu.classList.toggle('hidden');
    });

    // Auto close when link is clicked
    navMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        navMenu.classList.add('hidden');
      });
    });
  }
</script>
