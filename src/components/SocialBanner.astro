---
// Social & Flyer Showcase Banner Component in #061f69 Background
---

<section class="w-full bg-[#061f69] text-white py-12 sm:py-18 md:py-24 relative overflow-hidden z-10 border-b border-blue-900/50 select-none">
  
  <!-- Ambient Decorative Background Rings & Radial Glows -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden select-none">
    <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full border-[40px] border-white/[0.03]"></div>
    <div class="absolute -bottom-32 right-10 w-[500px] h-[500px] rounded-full border-[50px] border-white/[0.03]"></div>
    <div class="absolute top-1/2 left-1/3 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-blue-500/[0.08] rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 lg:gap-8 items-center">
      
      <!-- Left Column: 2 Layered Mobile Phone Mockups (Matching KFC Reference) -->
      <div class="lg:col-span-6 flex items-center justify-center relative">
        <div class="relative w-full max-w-[300px] sm:max-w-[380px] md:max-w-[420px] h-[360px] sm:h-[430px] md:h-[490px] flex items-center justify-center">
          
          <!-- Phone 2 (Back / Right Layer showing Flyer 2) -->
          <div class="absolute top-3 sm:top-4 right-1 sm:right-4 w-[160px] sm:w-[210px] md:w-[240px] h-[300px] sm:h-[380px] md:h-[430px] rounded-[24px] sm:rounded-[32px] md:rounded-[36px] bg-slate-900 p-1.5 sm:p-2 md:p-2.5 shadow-2xl shadow-black/80 border-2 border-slate-700/60 transform rotate-6 hover:rotate-2 transition-transform duration-500 overflow-hidden z-10 group">
            
            <!-- Phone Screen Area -->
            <div class="w-full h-full rounded-[18px] sm:rounded-[24px] md:rounded-[28px] overflow-hidden bg-slate-950 relative">
              <!-- Top Speaker Notch -->
              <div class="absolute top-1.5 sm:top-2 left-1/2 -translate-x-1/2 w-12 sm:w-16 h-2.5 sm:h-3.5 bg-slate-900 rounded-full z-20 flex items-center justify-center">
                <div class="w-2 h-2 rounded-full bg-slate-800"></div>
              </div>

              <!-- Flyer 2 Image -->
              <img
                src="/assets/flayer2.jpg"
                alt="Flyer Layanan AC Family Teknik"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
          </div>

          <!-- Phone 1 (Front / Left Layer showing Flyer 1 Video/Reel) -->
          <div class="absolute bottom-0 left-1 sm:left-2 w-[170px] sm:w-[220px] md:w-[250px] h-[310px] sm:h-[390px] md:h-[450px] rounded-[24px] sm:rounded-[32px] md:rounded-[36px] bg-slate-950 p-1.5 sm:p-2 md:p-2.5 shadow-[0_25px_50px_rgba(0,0,0,0.8)] border-2 border-blue-400/40 transform -rotate-3 hover:rotate-0 transition-transform duration-500 overflow-hidden z-20 group">
            
            <!-- Phone Screen Area -->
            <div class="w-full h-full rounded-[18px] sm:rounded-[24px] md:rounded-[28px] overflow-hidden bg-slate-900 relative">
              <!-- Top Speaker Notch -->
              <div class="absolute top-1.5 sm:top-2 left-1/2 -translate-x-1/2 w-14 sm:w-20 h-3 sm:h-4 bg-slate-950 rounded-full z-20 flex items-center justify-center gap-1.5 sm:gap-2">
                <div class="w-6 sm:w-8 h-1 sm:h-1.5 rounded-full bg-slate-800"></div>
                <div class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-blue-900"></div>
              </div>

              <!-- Flyer 1 Video Loop -->
              <video
                src="/assets/flayer1.mp4"
                autoplay
                loop
                muted
                playsinline
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              ></video>

              <!-- Subtle Gradient Overlay at bottom for clean depth -->
              <div class="absolute inset-x-0 bottom-0 h-14 sm:h-16 bg-gradient-to-t from-black/60 to-transparent pointer-events-none"></div>
            </div>
          </div>

        </div>
      </div>

      <!-- Right Column: Headlines + Direct Social Media CTA Badges -->
      <div class="lg:col-span-6 space-y-4 sm:space-y-6 text-center lg:text-left">
        
        <!-- Sub-tag -->
        <span class="text-xs sm:text-[13px] font-black uppercase tracking-widest text-cyan-400 block">
          KONSULTASI & UPDATE PROMO RESMI
        </span>

        <!-- Main Headline -->
        <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black uppercase tracking-tight text-white leading-[1.1] drop-shadow-sm font-sans">
          Layanan Servis & Cuci AC Langsung di Ponsel Anda
        </h2>

        <!-- Description -->
        <p class="text-xs sm:text-sm md:text-base text-slate-300 max-w-xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Dapatkan update promo cuci berkala, tips merawat AC tetap dingin maksimal, serta kemudahan reservasi teknisi panggilan cepat tanpa perlu download aplikasi tambahan.
        </p>

        <!-- Social Media Badges (White Card Buttons) -->
        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-3 sm:gap-4">
          
          <!-- Button 1: WhatsApp Admin Resmi (Pure White) -->
          <a
            href="https://wa.me/6288219639143?text=Halo%20PT%20Family%20Teknik%20Paimin%20Groups,%20saya%20ingin%20konsultasi%20layanan%20AC"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center sm:justify-start gap-3.5 sm:gap-4 px-5 sm:px-7 py-3 sm:py-3.5 rounded-2xl bg-white hover:bg-slate-100 text-slate-900 shadow-xl shadow-black/30 hover:scale-105 active:scale-95 transition-all duration-300 group select-none border border-white"
          >
            <!-- WhatsApp Pure SVG Icon -->
            <div class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center shrink-0">
              <svg class="w-7 h-7 sm:w-8 sm:h-8 text-emerald-600 group-hover:scale-110 transition-transform duration-200" fill="currentColor" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
            </div>
            <div class="text-left">
              <span class="block text-[10px] text-slate-500 font-extrabold uppercase tracking-wider">Chat WhatsApp</span>
              <span class="block text-xs sm:text-sm font-black text-slate-900 group-hover:text-emerald-600 transition-colors">Admin 1 & 2</span>
            </div>
          </a>

          <!-- Button 2: Instagram Resmi (Pure White) -->
          <a
            href="https://www.instagram.com/acservice.jabodetabek/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center sm:justify-start gap-3.5 sm:gap-4 px-5 sm:px-7 py-3 sm:py-3.5 rounded-2xl bg-white hover:bg-slate-100 text-slate-900 shadow-xl shadow-black/30 hover:scale-105 active:scale-95 transition-all duration-300 group select-none border border-white"
          >
            <!-- Instagram Pure SVG Icon -->
            <div class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center shrink-0">
              <svg class="w-7 h-7 sm:w-8 sm:h-8 text-[#E1306C] group-hover:scale-110 transition-transform duration-200" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </div>
            <div class="text-left">
              <span class="block text-[10px] text-slate-500 font-extrabold uppercase tracking-wider">Instagram Resmi</span>
              <span class="block text-xs sm:text-sm font-black text-slate-900 group-hover:text-[#E1306C] transition-colors">@acservice.jabodetabek</span>
            </div>
          </a>

        </div>

      </div>

    </div>
  </div>
</section>
