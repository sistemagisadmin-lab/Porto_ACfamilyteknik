---

<section id="layanan" class="py-20 md:py-32 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <h2 class="text-xs uppercase tracking-widest font-bold text-cyan-400">Layanan Unggulan Kami</h2>
      <p class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
        Solusi Komprehensif untuk Semua Kebutuhan Pendingin
      </p>
      <p class="text-slate-400 text-base sm:text-lg">
        Ditangani oleh teknisi bersertifikasi dan berpengalaman, memastikan sistem pendingin Anda bekerja optimal, hemat daya, dan tahan lama.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {services.map((service) => (
        <div class={`glass-panel glass-panel-hover rounded-3xl p-8 flex flex-col justify-between relative group ${service.popular ? 'border-cyan-500/40 ring-1 ring-cyan-500/20' : 'border-slate-800'}`}>
          
          <div>
            <!-- Header Card: Icon & Tag -->
            <div class="flex items-center justify-between mb-6">
              <div class="w-14 h-14 rounded-2xl bg-slate-900 border border-slate-700/80 flex items-center justify-center group-hover:border-cyan-500/50 group-hover:bg-cyan-950/30 transition-all duration-300">
                <Fragment set:html={service.icon} />
              </div>
              <span class={`text-[11px] font-semibold px-3 py-1 rounded-full border ${service.popular ? 'bg-cyan-500/20 text-cyan-300 border-cyan-500/40' : 'bg-slate-800 text-slate-400 border-slate-700'}`}>
                {service.tag}
              </span>
            </div>

            <!-- Title & Description -->
            <h3 class="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors duration-200 mb-3">
              {service.title}
            </h3>
            <p class="text-slate-400 text-sm leading-relaxed">
              {service.description}
            </p>
          </div>

          <!-- Bottom Action -->
          <div class="pt-6 mt-6 border-t border-slate-800/80 flex items-center justify-between">
            <a
              href={`https://wa.me/6281234567890?text=Halo,%20saya%20tertarik%20dengan%20layanan%20${encodeURIComponent(service.title)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-bold text-cyan-400 hover:text-cyan-300 flex items-center gap-1.5 transition-all group-hover:translate-x-1"
            >
              Pesan Layanan
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <span class="text-xs text-slate-500 font-medium">Garansi Resmi</span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
