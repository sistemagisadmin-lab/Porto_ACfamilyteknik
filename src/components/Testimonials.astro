---
const testimonials = [
  {
    name: "Hendri Pratama",
    role: "Facility Manager PT Sinar Maju",
    avatar: "HP",
    comment: "Kontrak pemeliharaan HVAC 15 lantai di kantor kami ditangani dengan sangat rapi. Jadwal teratur, report digital lengkap, dan kompresor tidak pernah bermasalah lagi.",
    rating: 5
  },
  {
    name: "Dr. Amanda Kusuma",
    role: "Pemilik Klinik Gigi Estetika",
    avatar: "AK",
    comment: "Sangat higienis! Teknisi memakai cover sepatu dan pelindung plastik saat mencuci AC di ruang praktik. Udara langsung fresh dan tidak berisik sama sekali.",
    rating: 5
  },
  {
    name: "Bambang Wibowo",
    role: "Penghuni Cluster Grand Victoria",
    avatar: "BW",
    comment: "AC inverter di rumah mati total pas hari libur, teknisi AC-COMPRO datang dalam 40 menit setelah WhatsApp. Sparepart diganti di tempat dan langsung dingin optimal!",
    rating: 5
  }
];
---

<section id="testimoni" class="py-20 md:py-32 relative bg-slate-900/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <h2 class="text-xs uppercase tracking-widest font-bold text-cyan-400">Kepuasan Klien</h2>
      <p class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
        Dipercaya oleh Ribuan Hunian & Bisnis
      </p>
      <p class="text-slate-400 text-base">
        Inilah tanggapan jujur para pelanggan setia yang telah merasakan kenyamanan udara dari layanan kami.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((item) => (
        <div class="glass-panel p-8 rounded-3xl border-slate-800 flex flex-col justify-between hover:border-cyan-500/30 transition-all duration-300">
          
          <div>
            <!-- Stars -->
            <div class="flex items-center gap-1 text-amber-400 mb-6">
              {[...Array(item.rating)].map(() => (
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            <!-- Comment -->
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed italic mb-8">
              "{item.comment}"
            </p>
          </div>

          <!-- Author Info -->
          <div class="flex items-center gap-4 pt-4 border-t border-slate-800/80">
            <div class="w-11 h-11 rounded-full bg-gradient-to-tr from-cyan-600 to-blue-600 flex items-center justify-center text-white font-bold text-sm shadow-md">
              {item.avatar}
            </div>
            <div>
              <p class="text-sm font-bold text-white">{item.name}</p>
              <p class="text-xs text-slate-400">{item.role}</p>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
