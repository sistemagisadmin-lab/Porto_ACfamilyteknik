---
const navLinks = [
  { name: "ABOUT US", href: "#tentang" },
  { name: "SERVICES", href: "#layanan" },
  { name: "CAMPAIGNS / PROMO", href: "#promo" },
  { name: "FIND US", href: "#lokasi" },
  { name: "CONTACT", href: "#kontak" },
];
---

<header class="w-full bg-[#1e2dfc] text-white transition-all duration-300 z-50">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="flex items-center justify-between h-20 md:h-24">
      
      <!-- Left: Bold Brand Logo (KFC Style aesthetic for AC Family Teknik) -->
      <a href="/" class="flex items-center gap-2 group tracking-tighter">
        <span class="text-3xl sm:text-4xl font-black italic tracking-tight text-white drop-shadow-sm select-none font-sans uppercase">
          AC<span class="text-yellow-400">FAMILY</span>
        </span>
      </a>

      <!-- Middle/Right: Navigation Links (Clean uppercase typography) -->
      <nav class="hidden lg:flex items-center gap-8 xl:gap-10">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-xs xl:text-sm font-extrabold uppercase tracking-widest text-white/90 hover:text-white hover:underline underline-offset-8 decoration-2 decoration-yellow-400 transition-all duration-200"
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Far Right: Circular Action Icons (Profile & Cart/Inquiry with Badge) -->
      <div class="hidden sm:flex items-center gap-4">
        
        <!-- Profile / Account Button -->
        <a
          href="tel:081234567890"
          aria-label="Kontak Hotline"
          class="w-11 h-11 rounded-full bg-white text-[#1e2dfc] flex items-center justify-center shadow-lg shadow-blue-900/30 hover:scale-110 active:scale-95 transition-all duration-200 group"
          title="Hubungi Kami"
        >
          <svg class="w-5 h-5 group-hover:scale-105 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </a>

        <!-- Booking Cart / Inquiry Badge Button -->
        <a
          href="https://wa.me/6281234567890?text=Halo%20AC%20Family%20Teknik,%20saya%20ingin%20pesan%20layanan"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Pemesanan & Keranjang Layanan"
          class="w-11 h-11 rounded-full bg-white text-[#1e2dfc] flex items-center justify-center shadow-lg shadow-blue-900/30 hover:scale-110 active:scale-95 transition-all duration-200 relative group"
          title="Pesan Layanan via WhatsApp"
        >
          <svg class="w-5 h-5 group-hover:scale-105 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <!-- Notification Counter Badge -->
          <span class="absolute -top-1 -right-1 w-5 h-5 rounded-full bg-red-600 text-white text-[10px] font-black flex items-center justify-center border-2 border-[#1e2dfc] shadow-sm animate-pulse">
            1
          </span>
        </a>

      </div>

      <!-- Mobile Menu Hamburger Button -->
      <div class="flex lg:hidden items-center">
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2.5 rounded-xl bg-white/10 text-white hover:bg-white/20 transition-colors focus:outline-none"
          aria-label="Toggle Menu"
        >
          <svg id="menu-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-white/10 bg-[#1623d6] px-6 py-5 space-y-4">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="mobile-nav-link block text-sm font-bold uppercase tracking-wider text-white/90 hover:text-yellow-400 py-1"
      >
        {link.name}
      </a>
    ))}

    <div class="pt-3 border-t border-white/10 flex items-center gap-4">
      <a
        href="https://wa.me/6281234567890"
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-white text-[#1e2dfc] font-bold text-sm shadow-md"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        Pesan / Konsultasi
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (btn && menu && menuIcon && closeIcon) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      menuIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>
